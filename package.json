{
  "name": "apple-04-review",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "mobile": "npm run start -w mobile",
    "mobile:web": "npm run web -w mobile",
    "mobile:export": "npm run export -w mobile",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w mobile",
    "test": "node --test tests/*.test.mjs",
    "audit:page": "node scripts/audit-page.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" \"mobile/**/*.{ts,tsx}\" \"shared/*.{ts,json}\" \"tests/*.mjs\""
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "prettier": "3.9.9",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
